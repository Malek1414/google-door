# Doorway — copy to .env (gitignored) and fill in. NEVER commit the real file.
#
# Gemini key from https://aistudio.google.com/apikey
# New keys are AQ.Ab... — that is correct and current. AIza keys are being
# rejected as of September 2026. Both work against generativelanguage.googleapis.com;
# only the OpenAI-compatible adapter routes reject AQ. keys, and we don't use them.
GEMINI_API_KEY=

# Google Cloud console key, Maps Platform. Needs these APIs enabled:
#   Places API (New)        -> accessibilityOptions, reviews for tier 3
#   Maps JavaScript API     -> the map view
# Restrict it by HTTP referrer before the QR goes public.
MAPS_API_KEY=

# Optional: key for POST /api/route (Routes API). Must be a classic AIza key with the
# Routes API enabled; AQ. keys get 401 there. Falls back to MAPS_API_KEY. When neither
# works the web app computes the route in the browser with the Maps JS key instead.
ROUTES_API_KEY=

# Optional model overrides
# GEMINI_MODEL_LOOK=gemini-3.6-flash
# GEMINI_MODEL_LIVED=gemini-3.8-flash
# GEMINI_MODEL_TTS=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# Native iOS Live View (ARCore Geospatial). Path to a Google Cloud service account JSON
# file, OUTSIDE the repo, in a project with the "ARCore API" enabled. The server mints
# short-lived tokens from it at GET /api/arcore-token; the key file itself never leaves
# the server. Leave empty to keep the web Live View.
ARCORE_SERVICE_ACCOUNT=
