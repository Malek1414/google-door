<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>de</string>
  <key>CFBundleDisplayName</key><string>Doorway</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <!-- Same #131314 as the webview background, so launch -> page has no white flash. -->
  <!-- iOS 27 refuses to launch an app without a scene manifest. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key><false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array><dict>
        <key>UISceneConfigurationName</key><string>Default</string>
        <key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
      </dict></array>
    </dict>
  </dict>
  <key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string></dict>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
  <key>UIViewControllerBasedStatusBarAppearance</key><false/>
  <!-- Doorway needs all three at once; the web app asks for them on the Start tap. -->
  <key>NSCameraUsageDescription</key>
  <string>Doorway zeigt den Weg zum stufenlosen Eingang in der Kameraansicht.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Doorway braucht deinen Standort, um dich zum richtigen Eingang zu führen.</string>
  <key>NSMotionUsageDescription</key>
  <string>Doorway nutzt den Kompass, um den Pfeil in die richtige Richtung zu drehen.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Nur für Sprachsuche.</string>
  <!-- Plain HTTP only to local addresses (the LAN dev server, localhost). Everything on the
       internet, including the serveo tunnel, must be HTTPS. -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict></plist>
