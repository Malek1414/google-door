// Copy to ios/Secrets.xcconfig (gitignored) and put the real key there.
//
// Only needed when the server cannot mint ARCore tokens (ARCORE_SERVICE_ACCOUNT unset).
// The key ends up inside the app bundle, so in Google Cloud Console > APIs & Services >
// Credentials restrict it to:
//   Application restriction: iOS apps, bundle id com.malek.doorway
//   API restriction:         ARCore API
ARCORE_API_KEY = DEIN_ARCORE_API_KEY
